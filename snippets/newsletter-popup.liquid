{%- unless customer -%}
  <newsletter-popup class="newsletter-popup" data-storage-key="libaas-newsletter-popup-dismissed">
    <div class="newsletter-popup__overlay"></div>
    <div class="newsletter-popup__dialog" role="dialog" aria-modal="true" aria-labelledby="NewsletterPopup-Heading">
      <button type="button" class="newsletter-popup__close link link--text focus-inset" aria-label="{{ 'accessibility.close' | t }}">
        {% render 'icon-close' %}
      </button>

      <p class="newsletter-popup__eyebrow">Join the Libaas List</p>
      <h2 id="NewsletterPopup-Heading" class="newsletter-popup__heading h1">Stay in the know</h2>
      <p class="newsletter-popup__text">
        Sign up for offers, new arrivals and the latest news from Dean&#8217;s Libaas.
      </p>

      {% form 'customer', class: 'newsletter-form newsletter-popup__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="newsletter-form__field-wrapper">
          <div class="field">
            <input
              id="NewsletterPopupForm"
              type="email"
              name="contact[email]"
              class="field__input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              {% if form.errors %}
                autofocus
                aria-invalid="true"
                aria-describedby="NewsletterPopup-error"
              {% elsif form.posted_successfully? %}
                aria-describedby="NewsletterPopup-success"
              {% endif %}
              placeholder="{{ 'newsletter.label' | t }}"
              required
            >
            <label class="field__label" for="NewsletterPopupForm">
              {{ 'newsletter.label' | t }}
            </label>
            <button
              type="submit"
              class="newsletter-form__button field__button"
              name="commit"
              aria-label="{{ 'newsletter.button_label' | t }}"
            >
              {% render 'icon-arrow' %}
            </button>
          </div>
          {%- if form.errors -%}
            <small class="newsletter-form__message form__message" id="NewsletterPopup-error">
              {%- render 'icon-error' -%}
              {{- form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email -}}
            </small>
          {%- endif -%}
        </div>
        {%- if form.posted_successfully? -%}
          <h3 class="newsletter-form__message newsletter-form__message--success form__message" id="NewsletterPopup-success" tabindex="-1" autofocus>
            {% render 'icon-success' -%}
            {{- 'newsletter.success' | t }}
          </h3>
        {%- endif -%}
      {% endform %}
    </div>
  </newsletter-popup>

  {%- style -%}
    .newsletter-popup {
      position: fixed;
      inset: 0;
      z-index: 100;
      display: none;
    }

    .newsletter-popup[open] {
      display: block;
    }

    .newsletter-popup__overlay {
      position: absolute;
      inset: 0;
      background: rgba(28, 27, 25, 0.55);
    }

    .newsletter-popup__dialog {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: min(440px, calc(100vw - 4rem));
      background: rgb(var(--color-background));
      color: rgb(var(--color-foreground));
      border-radius: var(--popup-corner-radius, 8px);
      padding: 4rem 3rem 3rem;
      text-align: center;
      box-shadow: 0 20px 60px rgba(28, 27, 25, 0.25);
    }

    .newsletter-popup__close {
      position: absolute;
      top: 1.5rem;
      right: 1.5rem;
      display: flex;
      padding: 0.5rem;
    }

    .newsletter-popup__eyebrow {
      margin: 0 0 0.6rem;
      font-size: 1.2rem;
      letter-spacing: 0.2rem;
      text-transform: uppercase;
      color: #B08D46;
      font-weight: 600;
    }

    .newsletter-popup__heading {
      margin: 0 0 1.2rem;
    }

    .newsletter-popup__text {
      margin: 0 0 2rem;
      color: rgba(var(--color-foreground), 0.75);
    }

    .newsletter-popup__form .newsletter-form__field-wrapper {
      max-width: 100%;
      margin: 0 auto;
    }
  {%- endstyle -%}

  <script src="{{ 'newsletter-popup.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}
